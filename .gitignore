# ── 运行时数据（数据库 / 日志 / WebView2 缓存，每台机器各一份） ──
data/
dist/data/
.webview2/

# ── 本机测试凭据（SMTP 授权码等）：只在本机存在，绝不入库 ──
# 这些文件里有明文密码。仓库一旦推出去就等于公开，删 commit 也洗不掉历史。
tests/*.txt
tests/*.secret
tests/*.credential*
_*.txt
_*.log
_*.err
_*.bmp
_*.ahk
*.log

# ── 编译产物 ──
dist/

# ── 编辑器与系统噪音 ──
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# ── AutoHotkey 帮助文档（2MB，非运行必需） ──
runtime/AutoHotkey.chm

# ── 图标中间产物（只提交 note.ico） ──
assets/note-*.png
