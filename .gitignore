_*.txt
_*.log
_*.err
_*.bmp
_*.ahk
*.log

# ── 编译产物 ──
dist/

# ── 编辑器与系统噪音 ──
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# ── AutoHotkey 帮助文档（2MB，非运行必需） ──
runtime/AutoHotkey.chm

# ── 图标中间产物（只提交 note.ico） ──
assets/note-*.png
